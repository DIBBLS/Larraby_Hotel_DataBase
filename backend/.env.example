# Supabase → Project Settings → Database → Connection string
# "Transaction" pooler, port 6543 — the app uses this at runtime
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection, port 5432 — migrations use this (pgbouncer can't run them)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Staff login (NextAuth). Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
# The URL this app is deployed at (its own Vercel URL, not the landing page's)
NEXTAUTH_URL="http://localhost:3000"

# The hotel website's real origin(s) — comma-separated, no trailing slash.
# Lets its booking widget call GET /api/availability and POST /api/bookings
# cross-origin. Every other route ignores this (same-origin dashboard only).
WEBSITE_ORIGIN="https://larabbyhotel.com"
